# @at_clifford_yosys 的最小存根。
#
# 真实情况：这个 repo 由 rules_hdl 的 tools_extension 生成，内容是
# Clifford Wolf 的 Yosys（开源综合工具），提供 //:yosys 可执行程序，
# 以及 //:json11 等库。
#
# XLS 侧对它的引用有两处：
#   1. xls/synthesis/yosys/BUILD 的 yosys_util 依赖 //:json11
#      （yosys_util.cc 用 json11 解析 Yosys 的 JSON 输出）
#   2. xls/build_rules/*.bzl 与 xls/scheduling/BUILD 用 //:yosys 作为
#      Label 默认值（FDO 综合时才会真正执行）
#
# 本工程只做「P4 逻辑 → RTL」的功能验证，不走 FDO 综合，所以：
#   - json11 用**真源码**（dropbox/json11，两个文件，很小）—— 因为
#     yosys_util.cc 会真的 include 并使用它的 API，空存根编译不过
#   - yosys 用**占位脚本** —— 只在数据流里作为 Label 出现，不会被调用
#
# 将来若要走「codegen → 综合 → 真实时序」（方案里的 M4/M5），
# 必须换成真的 Yosys。

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# 真的 json11 源码（dropbox/json11）。
#
# 目录必须放 libs/json11/ 下：yosys_util.cc 的 include 写的是
#     #include "libs/json11/json11.hpp"
# 所以 includes = ["."] 之后这个路径才解析得到。
# 而 json11.cpp 内部写的是 #include "json11.hpp"（同目录引用），
# 引号形式会先搜当前文件所在目录 → libs/json11/json11.hpp，同样成立。
cc_library(
    name = "json11",
    srcs = ["libs/json11/json11.cpp"],
    hdrs = ["libs/json11/json11.hpp"],
    includes = ["."],
)

# Yosys 占位：真实的 Yosys 是可执行程序，这里只保证 label 可解析。
sh_binary(
    name = "yosys",
    srcs = ["yosys_placeholder.sh"],
)
