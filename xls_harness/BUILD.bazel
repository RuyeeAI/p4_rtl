# A1 验证件的 BUILD 定义
#
# 由 scripts/setup_xls_harness.sh 复制到 third_party/xls/p4xls_harness/。
# BUILD 必须位于 XLS 工作区内，才能引用 //xls/ir:* 这些 label。
#
# 依赖裁剪原则：只链接 //xls/ir 链路，**不碰** //xls/tools、//xls/jit
# 或 //xls/common/file（这三条的 BUILD 文件里都有 @llvm-project 引用，
# 而 @llvm-project 已被轻量 MODULE.bazel 摘掉）。验证见 docs/A1-环境报告.md。

load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

# 诊断用：不依赖任何 //xls/* 包。用来判断 @llvm-project 的 label 解析
# 错误是出在 XLS 源码层，还是外部 module / toolchain 层。
cc_binary(
    name = "probe_minimal",
    srcs = ["probe_minimal.cc"],
)

cc_binary(
    name = "ir_check_main",
    srcs = ["ir_check_main.cc"],
    deps = [
        "//xls/common:init_xls",
        # 注意：xls/ir 包里没有 :block / :function / :proc 这些独立 target，
        # block.{h,cc} / function.{h,cc} / proc.{h,cc} 都是 :ir 这个
        # cc_library 的 srcs/hdrs。写成 :block 会报
        # "no such target '//xls/ir:block' (did you mean block.h?)"。
        "//xls/ir",
        "//xls/ir:ir_parser",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
    ],
)

# 自建 Verilog codegen 驱动（M0 用）。
#
# 刻意**不**链接 //xls/tools:codegen —— 那条链是：
#   //xls/tools:codegen → //xls/fdo:synthesizer
#     → //xls/synthesis/yosys:yosys_synthesis_service
#       → @at_clifford_yosys//:json11   （需要 Yosys 与 json11）
#
# 干净入口在 //xls/codegen_v_1_5:codegen：实测其 BUILD 里
# fdo/yosys/llvm/jit 出现次数均为 0，且它正是新式 proc 走的 codegen 路径。
cc_binary(
    name = "verilog_codegen_main",
    srcs = ["verilog_codegen_main.cc"],
    deps = [
        "//xls/codegen:codegen_options",
        "//xls/codegen:codegen_result",
        "//xls/codegen_v_1_5:codegen",
        # **必须有**：codegen 的默认 pass 注册表。
        # xls::codegen::Codegen() 内部会做
        #   GetCodegenPassRegistry().Generator("default_pipeline")
        # 而这个名为 default_pipeline 的 compound pass 由
        # xls_default_codegen_pass_registry(name="passes") 提供。
        # 它不在 :codegen 的 deps 里（官方是 //xls/tools:codegen 显式依赖
        # //xls/codegen_v_1_5:passes，xls/tools/BUILD:845）。
        # 漏掉它的症状是：
        #   default_pipeline is not registered. Have [opt_pass<...>, ...]
        # 注意这个错误**只在调度成功之后**才会出现 —— 调度失败时会先报
        # "cannot achieve full throughput"，很容易误判成调度问题。
        "//xls/codegen_v_1_5:passes",
        "//xls/common:init_xls",
        "//xls/estimators/delay_model:delay_estimator",
        "//xls/ir",
        "//xls/ir:ir_parser",
        "//xls/scheduling:scheduling_options",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
    ],
)
