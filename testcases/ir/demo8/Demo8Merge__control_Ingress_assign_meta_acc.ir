// p4c: package Demo8Merge
// p4c: fn control_Ingress_assign_meta_acc
// p4c-params: in_meta_a=in:meta.a
// p4c-params: in_meta_b=in:meta.b
// p4c-params: in_meta_c=in:meta.c
// p4c-params: in_meta_d=in:meta.d
// p4c-sinks: out:meta.acc:16
// p4c-stages: n0=0,n1=0,n2=1
package Demo8Merge

fn control_Ingress_assign_meta_acc(in_meta_a: bits[16], in_meta_b: bits[16], in_meta_c: bits[16], in_meta_d: bits[16]) -> (bits[16]) {
  n0: bits[16] = add(in_meta_a, in_meta_b)
  n1: bits[16] = add(in_meta_c, in_meta_d)
  n2: bits[16] = add(n0, n1)
  ret sinks: (bits[16]) = tuple(n2)
}
