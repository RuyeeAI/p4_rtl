// p4c: package Demo5Pipeline
// p4c: fn table_proto_table_count
// p4c-params: reg_per_proto=reg:per_proto
// p4c-sinks: reg:per_proto:8:16,cnt:total:8:32,out:meta.cls:8
package Demo5Pipeline

fn table_proto_table_count(reg_per_proto: bits[16][8]) -> (bits[3], bits[16], bits[3], bits[32], bits[8]) {
  n0: bits[3] = literal(value=0)
  n1: bits[16] = array_index(reg_per_proto, indices=[n0])
  n2: bits[16] = literal(value=1)
  n3: bits[16] = add(n1, n2)
  n4: bits[32] = literal(value=1)
  n5: bits[8] = literal(value=1)
  ret sinks: (bits[3], bits[16], bits[3], bits[32], bits[8]) = tuple(n0, n3, n0, n4, n5)
}
