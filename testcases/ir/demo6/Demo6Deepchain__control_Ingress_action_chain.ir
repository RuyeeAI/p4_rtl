package Demo6Deepchain

fn control_Ingress_action_chain(in_meta_f0: bits[16], in_meta_f1: bits[16], in_meta_f2: bits[16], in_meta_f3: bits[16], in_meta_f4: bits[16], in_meta_f5: bits[16], in_meta_f6: bits[16], in_meta_f7: bits[16], in_meta_f8: bits[16], in_meta_f9: bits[16], in_meta_f10: bits[16], in_meta_f11: bits[16], in_meta_f12: bits[16], in_meta_f13: bits[16], in_meta_f14: bits[16], in_meta_f15: bits[16], in_meta_acc: bits[16]) -> (bits[16], bits[3], bits[16], bits[3], bits[32]) {
  n0: bits[16] = add(in_meta_f0, in_meta_f1)
  n1: bits[16] = add(in_meta_f2, in_meta_f3)
  n2: bits[16] = add(n0, n1)
  n3: bits[16] = add(in_meta_f4, in_meta_f5)
  n4: bits[16] = add(in_meta_f6, in_meta_f7)
  n5: bits[16] = add(n3, n4)
  n6: bits[16] = add(n2, n5)
  n7: bits[16] = add(in_meta_f8, in_meta_f9)
  n8: bits[16] = add(in_meta_f10, in_meta_f11)
  n9: bits[16] = add(n7, n8)
  n10: bits[16] = add(in_meta_f12, in_meta_f13)
  n11: bits[16] = add(in_meta_f14, in_meta_f15)
  n12: bits[16] = add(n10, n11)
  n13: bits[16] = add(n9, n12)
  n14: bits[16] = add(n6, n13)
  n15: bits[3] = literal(value=0)
  n16: bits[32] = literal(value=1)
  ret sinks: (bits[16], bits[3], bits[16], bits[3], bits[32]) = tuple(n14, n15, in_meta_acc, n15, n16)
}
