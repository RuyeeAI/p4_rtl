// p4c-sinks: out:meta.acc:16
// p4c-stages: n0=0,n1=0,n2=0,n3=1,n4=1,n5=2,n6=2,n7=2,n8=3,n9=3,n10=3
package Demo11Multicycle

fn control_Ingress_action_mix(in_meta_f0: bits[16], in_meta_f1: bits[16], in_meta_f2: bits[16], in_meta_f3: bits[16], in_meta_f4: bits[16], in_meta_f5: bits[16], in_meta_f6: bits[16], in_meta_f7: bits[16], in_meta_f8: bits[16], in_meta_f9: bits[16], in_meta_f10: bits[16], in_meta_f11: bits[16]) -> (bits[16]) {
  n0: bits[16] = add(in_meta_f0, in_meta_f1)
  n1: bits[16] = xor(n0, in_meta_f2)
  n2: bits[16] = add(n1, in_meta_f3)
  n3: bits[16] = xor(n2, in_meta_f4)
  n4: bits[16] = add(n3, in_meta_f5)
  n5: bits[16] = xor(n4, in_meta_f6)
  n6: bits[16] = add(n5, in_meta_f7)
  n7: bits[16] = xor(n6, in_meta_f8)
  n8: bits[16] = add(n7, in_meta_f9)
  n9: bits[16] = xor(n8, in_meta_f10)
  n10: bits[16] = add(n9, in_meta_f11)
  ret sinks: (bits[16]) = tuple(n10)
}
