// p4c: package Demo11Multicycle
// p4c: fn control_Ingress_action_mix
// p4c-params: in_meta_f0=in:meta.f0
// p4c-params: in_meta_f1=in:meta.f1
// p4c-params: in_meta_f2=in:meta.f2
// p4c-params: in_meta_f3=in:meta.f3
// p4c-params: in_meta_f4=in:meta.f4
// p4c-params: in_meta_f5=in:meta.f5
// p4c-params: in_meta_f6=in:meta.f6
// p4c-params: in_meta_f7=in:meta.f7
// p4c-params: in_meta_f8=in:meta.f8
// p4c-params: in_meta_f9=in:meta.f9
// p4c-params: in_meta_f10=in:meta.f10
