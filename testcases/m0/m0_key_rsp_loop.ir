// M0 打样：Key/Response 握手闭环的最小 proc（**II=1 版本**）
//
// ============================ 验证目标 ============================
// 问题（方案里的头号风险）：
//   XLS 的 proc.next(state) 是「每拍迭代一次」的模型，而外部存储器有延迟。
//   "发出 key → 等 response 返回 → 分发" 这个闭环能不能在 XLS 里成立？
//   —— 文档没有承诺，必须实测。
//
// 郝宇 2026-09-15 对语义的澄清：
//   **L 是查找的最大延时值，response 返回时后续逻辑才开始工作。**
//   所以不是"死等固定 L 拍"，而是"等到 response 真的回来"。
//
// ============================ 设计思路 ============================
// 用 proc 的 state 表达三态机：
//
//   IDLE ──(发 key)──→ WAIT ──(收到 rsp)──→ DISPATCH ──(分发结果)──→ IDLE
//
// 三个通道都用 streaming，但**流控方式不同**：
//   key_out     : 我发给外部存储器的查找键      → flow_control=valid_data（无 rdy）
//   rsp_in      : 外部存储器返回的 response     → flow_control=valid_data（无 rdy）
//   result_out  : 拿到 response 后才开始工作的后续逻辑输出 → ready_valid（保留 rdy）
//
// 为什么 key/rsp 去掉 rdy（2026-09-16 郝宇要求）：
//   Key/Response 是「XLS 侧 ↔ 外部存储器/加速器」的接口，约定为**无背压**：
//     - key_out 方向：外部表/存储器被约定**随时可接收**
//     - rsp_in  方向：外部表/存储器被约定**随时会返回**，XLS 侧不表达"能否接收"
//   好处：接口位宽与握手逻辑都减半，且绕开了 M0 报告里记的那个坑 ——
//   XLS 生成的 rdy 语义是「本拍完成一次接收」而非「我随时能收」，
//   对外部行为模型容易误用。去掉 rdy 后这个歧义不存在了。
//
// 代价（必须写进接口契约，见 docs/M0-接口打样报告.md）：
//   外部侧**不得**在某拍不能接收/返回时让 vld=1 —— 没有 rdy 可供它等待。
//   若外部真的存在不可用窗口，必须在外部自行缓冲（FIFO）。
//
// result_out 保留 ready_valid：下游是 XLS 生成的逻辑/真实下游，背压有意义。
//
// 实现依据：FlowControl 枚举共三值（channel.h:301-320），
//   kValidData 的注释原文即 "This is used when the channel doesn't want to
//   support backpressure"。codegen 侧只有非 kValidData 才生成 rdy 端口
//   （channel_to_port_io_lowering_pass.cc:371）。
//
// **关键机制 1（时序契约）**：`receive(predicate=is_wait, channel=rsp_in)`
//   - phase==WAIT 且 rsp_in 上**没有数据**时，predicate 为真但数据未就绪
//     → 整个 proc 迭代被 stall（不推进），state 保持不变
//   - 数据到达的那一拍 receive 完成，phase 推进到 DISPATCH
//   → **这就是"等到 response 返回"的自然表达，不需要显式计数 L。**
//
// **关键机制 2（II=1，P0 的结论）**：三个通道操作**互不串链**
//   串行 token 链（旧版 m0_key_rsp_loop_serial_token.ir）：
//       state_read(tok) → send(key) → receive(rsp) → send(result) → next(tok)
//   这条链是**循环携带依赖**，跨多拍 → 实测最小 II = 2 且 stages=1 完全不可调度。
//   本版改成**并行 token**：三个通道操作都直接接 state_read(tok)，
//   末尾用 after_all 汇聚：
//       s_key = send(tok__1, ...)
//       recv  = receive(tok__1, ...)
//       s_out = send(tok__1, ...)
//       next(tok) = after_all(s_key, tok__2, s_out)
//   → 实测 **最小 II = 1**（stages 1..4 全部可行），且功能由 testbench 复验不变。
//   并在 IR 里用 #[initiation_interval(1)] 显式声明。
//
//   语义等价性：三个操作的 predicate（is_idle / is_wait / is_disp）按 FSM 相位
//   **互斥**，不会同拍为真，所以去掉串行 token 依赖不影响功能正确性。
//
// **这两个机制都必须由生成的 RTL 与仿真来确认，不能只看推理。**

package m0_key_rsp

// II 由 **IR 自己声明**（不在 driver 参数里指定），这样生成的 .ir 是自描述的，
// 任何 XLS 工具都能正确处理。
// 依据：run_pipeline_schedule.cc:464-520 —— 当命令行没有 wct 时，
// 调度器会读 proc 的 initiation_interval 属性。
// 注意：若同时给了 --wct=N，**选项优先**于属性。
#[initiation_interval(1)]
top proc key_rsp_loop<
    key_out: bits[64] out,
    rsp_in: bits[32] in,
    result_out: bits[32] out
>(
    tok: token,
    phase: bits[2],
    rsp_hold: bits[32],
    init={token, 0, 0}
) {
  // 三个通道都用 proven_mutually_exclusive：每个通道只有一个 send/receive
  // 语句，多个操作之间不可能同拍并发，故严格成立。
  // 注意 strictness 是**必填项**（proc-scoped chan_interface 没有默认值）。
  //
  // flow_control=valid_data 的语义（channel.h:312-319）：
  //   "a valid signal indicates that the data is valid, and the receiver is
  //    presumed to always be ready to accept data. A transaction occurs
  //    whenever valid is asserted."
  //   → 生成 <chan>_vld 与 <chan>，**不生成 <chan>_rdy**。
  chan_interface key_out(direction=send, kind=streaming, strictness=proven_mutually_exclusive, flow_control=valid_data, flop_kind=none)
  chan_interface rsp_in(direction=receive, kind=streaming, strictness=proven_mutually_exclusive, flow_control=valid_data, flop_kind=none)
  chan_interface result_out(direction=send, kind=streaming, strictness=proven_mutually_exclusive, flow_control=ready_valid, flop_kind=none)

  // ---- 读状态 ----
  tok__1: token = state_read(state_element=tok, id=1)
  phase__1: bits[2] = state_read(state_element=phase, id=2)
  rsp_hold__1: bits[32] = state_read(state_element=rsp_hold, id=3)

  // ---- 相位判定 ----
  p_idle: bits[2] = literal(value=0, id=4)
  p_wait: bits[2] = literal(value=1, id=5)
  p_disp: bits[2] = literal(value=2, id=6)
  is_idle: bits[1] = eq(phase__1, p_idle, id=7)
  is_wait: bits[1] = eq(phase__1, p_wait, id=8)
  is_disp: bits[1] = eq(phase__1, p_disp, id=9)

  // ---- IDLE：发出查找键 ----
  // 真实场景里 key 由 parser 抽出的 PHV 字段 concat 而成；
  // M0 用常量，把变量收敛到"时序契约"这一个问题上。
  key: bits[64] = literal(value=11936128518282651045, id=10)

  // ---- 三个通道操作：都直接接 tok__1，互不串链（这是 II=1 的关键）----
  //
  // IDLE 拍发 key
  s_key: token = send(tok__1, key, predicate=is_idle, channel=key_out, id=11)
  // WAIT 拍收 response（阻塞点）
  recv: (token, bits[32]) = receive(tok__1, predicate=is_wait, channel=rsp_in, id=12)
  tok__2: token = tuple_index(recv, index=0, id=13)
  rsp: bits[32] = tuple_index(recv, index=1, id=14)
  // DISPATCH 拍发结果（用 rsp_hold 而不是 rsp：rsp 只在 WAIT 拍有效）
  s_out: token = send(tok__1, rsp_hold__1, predicate=is_disp, channel=result_out, id=15)

  // ---- 相位推进 ----
  // sel 的 cases 是**值列表**，按 selector 取值顺序索引；元素必须是已定义的节点引用。
  n_wait: bits[2] = literal(value=1, id=16)
  n_disp: bits[2] = literal(value=2, id=17)
  n_idle: bits[2] = literal(value=0, id=18)
  next_phase: bits[2] = sel(
      phase__1,
      cases=[n_wait, n_disp, n_idle],
      default=n_idle,
      id=19)

  // ---- 保存 response ----
  // 只在 WAIT 拍（phase==1）采样 rsp，其余拍保持原值。
  next_rsp_hold: bits[32] = sel(
      phase__1,
      cases=[rsp_hold__1, rsp, rsp_hold__1],
      default=rsp_hold__1,
      id=20)

  // ---- token 汇聚（末尾才合并，不构成串行链）----
  next_tok_all: token = after_all(s_key, tok__2, s_out, id=21)

  // 语法要点：next_value 是普通节点，同样要写 `name: type = ` 前缀，
  // 且它的返回类型是空元组 `()`；节点名后缀必须与 id 一致。
  next_value.22: () = next_value(state_element=tok, value=next_tok_all, id=22)
  next_value.23: () = next_value(state_element=phase, value=next_phase, id=23)
  next_value.24: () = next_value(state_element=rsp_hold, value=next_rsp_hold, id=24)
}
