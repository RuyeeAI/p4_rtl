// A2 前置实验：同一 proc 内 **6 张表**（13 个通道）时的最小 II
//
// **本文件由 scripts/gen_multichan_probe.py 6 生成，请勿手改。**
//
// 目的：回答「一个 proc 里放多少对 Key/Response 通道后 II 会退化？」
//       A2 架构（整个 control 放进一个 proc）直接依赖这个结论。
//
// 结构：IDLE：发 key1 → WAIT1：收 rsp1 → MID1：发 key2 → WAIT2：收 rsp2 → MID2：发 key3 → WAIT3：收 rsp3 → MID3：发 key4 → WAIT4：收 rsp4 → MID4：发 key5 → WAIT5：收 rsp5 → MID5：发 key6 → WAIT6：收 rsp6 → DISPATCH：发 result
//
// 与 M0/P0 一致：通道操作都直连 state_read(tok__1)、互不串链；
// predicate(FSM 相位) 互斥；末尾 after_all 汇聚（13 个操作数）。
// 第 i 张表（i≥2）的 key 取自上张表的 response —— 复现真实表级串联依赖。
//
// 判定：最小 II 是否仍为 1。
//   scripts/ii_sweep.sh testcases/a2/ii_probe_6tables.ir probe_6tables

package a2_ii_probe_6tbl

#[initiation_interval(1)]
top proc probe_6tables<
    key1_out: bits[32] out,
    rsp1_in: bits[32] in,
    key2_out: bits[32] out,
    rsp2_in: bits[32] in,
    key3_out: bits[32] out,
    rsp3_in: bits[32] in,
    key4_out: bits[32] out,
    rsp4_in: bits[32] in,
    key5_out: bits[32] out,
    rsp5_in: bits[32] in,
    key6_out: bits[32] out,
    rsp6_in: bits[32] in,
    result_out: bits[32] out
>(
    tok: token,
    phase: bits[4],
    hold1: bits[32],
    hold2: bits[32],
    hold3: bits[32],
    hold4: bits[32],
    hold5: bits[32],
    hold6: bits[32],
    init={token, 0, 0, 0, 0, 0, 0, 0}
) {
  chan_interface key1_out(direction=send, kind=streaming, strictness=proven_mutually_exclusive, flow_control=valid_data, flop_kind=none)
  chan_interface rsp1_in(direction=receive, kind=streaming, strictness=proven_mutually_exclusive, flow_control=valid_data, flop_kind=none)
  chan_interface key2_out(direction=send, kind=streaming, strictness=proven_mutually_exclusive, flow_control=valid_data, flop_kind=none)
  chan_interface rsp2_in(direction=receive, kind=streaming, strictness=proven_mutually_exclusive, flow_control=valid_data, flop_kind=none)
  chan_interface key3_out(direction=send, kind=streaming, strictness=proven_mutually_exclusive, flow_control=valid_data, flop_kind=none)
  chan_interface rsp3_in(direction=receive, kind=streaming, strictness=proven_mutually_exclusive, flow_control=valid_data, flop_kind=none)
  chan_interface key4_out(direction=send, kind=streaming, strictness=proven_mutually_exclusive, flow_control=valid_data, flop_kind=none)
  chan_interface rsp4_in(direction=receive, kind=streaming, strictness=proven_mutually_exclusive, flow_control=valid_data, flop_kind=none)
  chan_interface key5_out(direction=send, kind=streaming, strictness=proven_mutually_exclusive, flow_control=valid_data, flop_kind=none)
  chan_interface rsp5_in(direction=receive, kind=streaming, strictness=proven_mutually_exclusive, flow_control=valid_data, flop_kind=none)
  chan_interface key6_out(direction=send, kind=streaming, strictness=proven_mutually_exclusive, flow_control=valid_data, flop_kind=none)
  chan_interface rsp6_in(direction=receive, kind=streaming, strictness=proven_mutually_exclusive, flow_control=valid_data, flop_kind=none)
  chan_interface result_out(direction=send, kind=streaming, strictness=proven_mutually_exclusive, flow_control=ready_valid, flop_kind=none)

  // ---- 读状态 ----
  tok__1: token = state_read(state_element=tok, id=1)
  phase__1: bits[4] = state_read(state_element=phase, id=2)
  hold1__1: bits[32] = state_read(state_element=hold1, id=3)
  hold2__1: bits[32] = state_read(state_element=hold2, id=4)
  hold3__1: bits[32] = state_read(state_element=hold3, id=5)
  hold4__1: bits[32] = state_read(state_element=hold4, id=6)
  hold5__1: bits[32] = state_read(state_element=hold5, id=7)
  hold6__1: bits[32] = state_read(state_element=hold6, id=8)

  // ---- 相位判定 ----
  // phase 0 = IDLE：发 key1
  p_0: bits[4] = literal(value=0, id=9)
  // phase 1 = WAIT1：收 rsp1
  p_1: bits[4] = literal(value=1, id=10)
  // phase 2 = MID1：发 key2
  p_2: bits[4] = literal(value=2, id=11)
  // phase 3 = WAIT2：收 rsp2
  p_3: bits[4] = literal(value=3, id=12)
  // phase 4 = MID2：发 key3
  p_4: bits[4] = literal(value=4, id=13)
  // phase 5 = WAIT3：收 rsp3
  p_5: bits[4] = literal(value=5, id=14)
  // phase 6 = MID3：发 key4
  p_6: bits[4] = literal(value=6, id=15)
  // phase 7 = WAIT4：收 rsp4
  p_7: bits[4] = literal(value=7, id=16)
  // phase 8 = MID4：发 key5
  p_8: bits[4] = literal(value=8, id=17)
  // phase 9 = WAIT5：收 rsp5
  p_9: bits[4] = literal(value=9, id=18)
  // phase 10 = MID5：发 key6
  p_10: bits[4] = literal(value=10, id=19)
  // phase 11 = WAIT6：收 rsp6
  p_11: bits[4] = literal(value=11, id=20)
  // phase 12 = DISPATCH：发 result
  p_12: bits[4] = literal(value=12, id=21)
  is_0: bits[1] = eq(phase__1, p_0, id=22)
  is_1: bits[1] = eq(phase__1, p_1, id=23)
  is_2: bits[1] = eq(phase__1, p_2, id=24)
  is_3: bits[1] = eq(phase__1, p_3, id=25)
  is_4: bits[1] = eq(phase__1, p_4, id=26)
  is_5: bits[1] = eq(phase__1, p_5, id=27)
  is_6: bits[1] = eq(phase__1, p_6, id=28)
  is_7: bits[1] = eq(phase__1, p_7, id=29)
  is_8: bits[1] = eq(phase__1, p_8, id=30)
  is_9: bits[1] = eq(phase__1, p_9, id=31)
  is_10: bits[1] = eq(phase__1, p_10, id=32)
  is_11: bits[1] = eq(phase__1, p_11, id=33)
  is_12: bits[1] = eq(phase__1, p_12, id=34)

  // ---- 通道操作：全部直接接 tok__1，互不串链（P0 定案）----
  key1: bits[32] = literal(value=1001, id=35)
  s_key1: token = send(tok__1, key1, predicate=is_0, channel=key1_out, id=36)
  recv1: (token, bits[32]) = receive(tok__1, predicate=is_1, channel=rsp1_in, id=37)
  t1: token = tuple_index(recv1, index=0, id=38)
  rsp1: bits[32] = tuple_index(recv1, index=1, id=39)
  s_key2: token = send(tok__1, hold1__1, predicate=is_2, channel=key2_out, id=40)
  recv2: (token, bits[32]) = receive(tok__1, predicate=is_3, channel=rsp2_in, id=41)
  t2: token = tuple_index(recv2, index=0, id=42)
  rsp2: bits[32] = tuple_index(recv2, index=1, id=43)
  s_key3: token = send(tok__1, hold2__1, predicate=is_4, channel=key3_out, id=44)
  recv3: (token, bits[32]) = receive(tok__1, predicate=is_5, channel=rsp3_in, id=45)
  t3: token = tuple_index(recv3, index=0, id=46)
  rsp3: bits[32] = tuple_index(recv3, index=1, id=47)
  s_key4: token = send(tok__1, hold3__1, predicate=is_6, channel=key4_out, id=48)
  recv4: (token, bits[32]) = receive(tok__1, predicate=is_7, channel=rsp4_in, id=49)
  t4: token = tuple_index(recv4, index=0, id=50)
  rsp4: bits[32] = tuple_index(recv4, index=1, id=51)
  s_key5: token = send(tok__1, hold4__1, predicate=is_8, channel=key5_out, id=52)
  recv5: (token, bits[32]) = receive(tok__1, predicate=is_9, channel=rsp5_in, id=53)
  t5: token = tuple_index(recv5, index=0, id=54)
  rsp5: bits[32] = tuple_index(recv5, index=1, id=55)
  s_key6: token = send(tok__1, hold5__1, predicate=is_10, channel=key6_out, id=56)
  recv6: (token, bits[32]) = receive(tok__1, predicate=is_11, channel=rsp6_in, id=57)
  t6: token = tuple_index(recv6, index=0, id=58)
  rsp6: bits[32] = tuple_index(recv6, index=1, id=59)
  s_out: token = send(tok__1, hold6__1, predicate=is_12, channel=result_out, id=60)

  // ---- 相位推进（k → k+1；末相位 → 0）----
  n_0: bits[4] = literal(value=0, id=61)
  n_1: bits[4] = literal(value=1, id=62)
  n_2: bits[4] = literal(value=2, id=63)
  n_3: bits[4] = literal(value=3, id=64)
  n_4: bits[4] = literal(value=4, id=65)
  n_5: bits[4] = literal(value=5, id=66)
  n_6: bits[4] = literal(value=6, id=67)
  n_7: bits[4] = literal(value=7, id=68)
  n_8: bits[4] = literal(value=8, id=69)
  n_9: bits[4] = literal(value=9, id=70)
  n_10: bits[4] = literal(value=10, id=71)
  n_11: bits[4] = literal(value=11, id=72)
  n_12: bits[4] = literal(value=12, id=73)
  next_phase: bits[4] = sel(
      phase__1,
      cases=[n_1, n_2, n_3, n_4, n_5, n_6, n_7, n_8, n_9, n_10, n_11, n_12, n_0],
      default=n_0,
      id=74)

  // ---- 保存各自 response（只在对应 WAIT 相位采样）----
  next_hold1: bits[32] = sel(
      phase__1,
      cases=[hold1__1, rsp1, hold1__1, hold1__1, hold1__1, hold1__1, hold1__1, hold1__1, hold1__1, hold1__1, hold1__1, hold1__1, hold1__1],
      default=hold1__1,
      id=75)
  next_hold2: bits[32] = sel(
      phase__1,
      cases=[hold2__1, hold2__1, hold2__1, rsp2, hold2__1, hold2__1, hold2__1, hold2__1, hold2__1, hold2__1, hold2__1, hold2__1, hold2__1],
      default=hold2__1,
      id=76)
  next_hold3: bits[32] = sel(
      phase__1,
      cases=[hold3__1, hold3__1, hold3__1, hold3__1, hold3__1, rsp3, hold3__1, hold3__1, hold3__1, hold3__1, hold3__1, hold3__1, hold3__1],
      default=hold3__1,
      id=77)
  next_hold4: bits[32] = sel(
      phase__1,
      cases=[hold4__1, hold4__1, hold4__1, hold4__1, hold4__1, hold4__1, hold4__1, rsp4, hold4__1, hold4__1, hold4__1, hold4__1, hold4__1],
      default=hold4__1,
      id=78)
  next_hold5: bits[32] = sel(
      phase__1,
      cases=[hold5__1, hold5__1, hold5__1, hold5__1, hold5__1, hold5__1, hold5__1, hold5__1, hold5__1, rsp5, hold5__1, hold5__1, hold5__1],
      default=hold5__1,
      id=79)
  next_hold6: bits[32] = sel(
      phase__1,
      cases=[hold6__1, hold6__1, hold6__1, hold6__1, hold6__1, hold6__1, hold6__1, hold6__1, hold6__1, hold6__1, hold6__1, rsp6, hold6__1],
      default=hold6__1,
      id=80)

  // ---- token 汇聚（13 个操作数）----
  next_tok_all: token = after_all(s_key1, t1, s_key2, t2, s_key3, t3, s_key4, t4, s_key5, t5, s_key6, t6, s_out, id=81)

  // 语法要点：next_value 要写 `next_value.<id>: () = ` 前缀（M0 K6）
  next_value.82: () = next_value(state_element=tok, value=next_tok_all, id=82)
  next_value.83: () = next_value(state_element=phase, value=next_phase, id=83)
  next_value.84: () = next_value(state_element=hold1, value=next_hold1, id=84)
  next_value.85: () = next_value(state_element=hold2, value=next_hold2, id=85)
  next_value.86: () = next_value(state_element=hold3, value=next_hold3, id=86)
  next_value.87: () = next_value(state_element=hold4, value=next_hold4, id=87)
  next_value.88: () = next_value(state_element=hold5, value=next_hold5, id=88)
  next_value.89: () = next_value(state_element=hold6, value=next_hold6, id=89)
}
