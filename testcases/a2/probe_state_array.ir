// A2-5b 前置实验：proc 的 state 能否是**数组类型**（extern Register/Counter 的方案 a）
//
// 验证点：
//   1. state 形参 `mem: bits[16][8]` 能否通过 parser
//   2. 数组 state 的 init 怎么写
//   3. array_index 读 / array_update 写 / next_value 写回数组
//   4. codegen 出的 RTL 是什么形态（寄存器组？）
//
// 行为：每拍把 mem[1] 的当前值发到 data_out，然后 mem[1] += 1。
// 预期仿真观测：data_out 依次出现 0, 1, 2, 3, ...

package a2_extern_probe

#[initiation_interval(1)]
top proc extern_probe<
    data_out: bits[16] out
>(
    tok: token,
    mem: bits[16][8],
    init={token, [0, 0, 0, 0, 0, 0, 0, 0]}
) {
  chan_interface data_out(direction=send, kind=streaming, strictness=proven_mutually_exclusive, flow_control=ready_valid, flop_kind=none)

  tok_1: token = state_read(state_element=tok, id=1)
  mem_2: bits[16][8] = state_read(state_element=mem, id=2)
  idx_3: bits[3] = literal(value=1, id=3)
  one_4: bits[16] = literal(value=1, id=4)
  old_5: bits[16] = array_index(mem_2, indices=[idx_3], id=5)
  inc_6: bits[16] = add(old_5, one_4, id=6)
  upd_7: bits[16][8] = array_update(mem_2, inc_6, indices=[idx_3], id=7)
  snd_8: token = send(tok_1, old_5, channel=data_out, id=8)
  next_value.9: () = next_value(state_element=mem, value=upd_7, id=9)
  next_value.10: () = next_value(state_element=tok, value=snd_8, id=10)
}
