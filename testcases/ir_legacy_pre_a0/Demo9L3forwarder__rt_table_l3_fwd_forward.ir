fn rt_table_l3_fwd_forward(in___rtarg_port: bits[16], in___rtarg_c: bits[8], in_hdr_ipv4_ttl: bits[8], in_hdr_ipv4_totalLen: bits[16], reg_portBytes: bits[16][8]) -> (bits[16], bits[8], bits[8], bits[2], bits[32], bits[3], bits[16]) {
