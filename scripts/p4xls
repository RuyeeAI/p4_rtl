#!/usr/bin/env bash
# p4xls CLI 包装脚本 —— 直接跑编译产物，避免 sbt 启动开销（约 5s -> 0.3s）。
#
# 前置：先 `sbt compile` 生成 target/scala-2.13/classes。
#
# 用法：
#   scripts/p4xls p4c gen testcases/p4/demo9-l3forwarder.p4 out/gen --dump-ir out/ir
#   scripts/p4xls lint-ir out/ir
#   scripts/p4xls version
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CLASSES="$ROOT/target/scala-2.13/classes"

if [ ! -d "$CLASSES" ]; then
  echo "未找到 $CLASSES —— 请先在工程根目录运行 'sbt compile'" >&2
  exit 2
fi

# 定位 scala-library（2.13.x）。优先用环境变量覆盖。
if [ -n "${P4XLS_SCALA_LIB:-}" ]; then
  SCALA_LIB="$P4XLS_SCALA_LIB"
else
  SCALA_LIB="$(find "$HOME/Library/Caches/Coursier" "$HOME/.cache/coursier" \
                    -name 'scala-library-2.13*.jar' 2>/dev/null | grep -v sources | head -1 || true)"
fi

if [ -z "$SCALA_LIB" ]; then
  echo "未找到 scala-library-2.13.x.jar；可用 P4XLS_SCALA_LIB 指定路径" >&2
  exit 2
fi

cd "$ROOT"
exec java -cp "$CLASSES:$SCALA_LIB" p4xls.Main "$@"
